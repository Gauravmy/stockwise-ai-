# ---- Backend (read by backend/app/config.py; copy to .env at the repo root or backend/) ----
# SQLite file used by the API. Default: backend/stockwise.db
# DATABASE_URL=sqlite:///C:/absolute/path/to/stockwise.db
# Comma-separated origins allowed by CORS (the Next.js dev server)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional regex for extra origins (e.g. Vercel preview URLs)
# CORS_ORIGIN_REGEX=^https://stockwise-ai[a-z0-9-]*\.vercel\.app$
LOG_LEVEL=INFO
# Upload limits
MAX_UPLOAD_BYTES=5242880
MAX_UPLOAD_ROWS=200000
# Run Alembic migrations automatically when the API starts
AUTO_MIGRATE=true

# ---- Frontend (copy to frontend/.env.local) ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
